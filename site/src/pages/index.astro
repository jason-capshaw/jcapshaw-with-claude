---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Hey, I'm Jason.</h1>
			<p>
				I build things, break things, and write about it here.
				This site runs on markdown and ships almost no JavaScript — unless a post needs it.
			</p>
			<p>
				Check out the <a href="/blog">blog</a> or learn more <a href="/about">about me</a>.
			</p>
		</main>
		<Footer />
	</body>
</html>
