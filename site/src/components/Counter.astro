---
interface Props {
	start?: number;
}
const { start = 0 } = Astro.props;
---

<div class="counter" data-start={start}>
	<button class="decrement" aria-label="Decrement">-</button>
	<span class="count">{start}</span>
	<button class="increment" aria-label="Increment">+</button>
</div>

<script>
	class CounterElement {
		constructor(el: Element) {
			const countEl = el.querySelector('.count')!;
			let count = parseInt(el.getAttribute('data-start') || '0');

			el.querySelector('.increment')!.addEventListener('click', () => {
				count++;
				countEl.textContent = String(count);
			});

			el.querySelector('.decrement')!.addEventListener('click', () => {
				count--;
				countEl.textContent = String(count);
			});
		}
	}

	document.querySelectorAll('.counter').forEach((el) => new CounterElement(el));
</script>

<style>
	.counter {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.5rem 1rem;
		background: rgb(var(--gray-light));
		border-radius: 8px;
		margin: 1rem 0;
	}
	button {
		width: 2.5rem;
		height: 2.5rem;
		border: none;
		border-radius: 6px;
		background: var(--accent);
		color: white;
		font-size: 1.25rem;
		font-weight: 700;
		cursor: pointer;
		transition: background 0.15s;
	}
	button:hover {
		background: var(--accent-dark);
	}
	.count {
		font-size: 1.5rem;
		font-weight: 700;
		min-width: 2rem;
		text-align: center;
	}
</style>
