---
const pathname = Astro.url.pathname;
const links = [
	{ href: '/writing', label: 'Writing' },
	{ href: '/about', label: 'About' },
	{ href: '/speaking', label: 'Speaking' },
	{ href: '/now', label: 'Now' },
	{ href: '/rss.xml', label: 'RSS' },
];
---

<header class="site-header">
	<a href="/" class="site-header__name">Jason Capshaw</a>
	<nav>
		<ul class="site-header__nav" id="nav-menu">
			{links.map((link) => (
				<li>
					<a
						href={link.href}
						style={pathname.startsWith(link.href) ? 'color: var(--color-text)' : undefined}
					>
						{link.label}
					</a>
				</li>
			))}
		</ul>
	</nav>
	<button class="site-header__toggle" id="nav-toggle" aria-label="Toggle menu">
		<svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
			<line x1="3" y1="6" x2="17" y2="6" />
			<line x1="3" y1="10" x2="17" y2="10" />
			<line x1="3" y1="14" x2="17" y2="14" />
		</svg>
	</button>
</header>
<div class="site-header__rule"></div>

<script>
	const toggle = document.getElementById('nav-toggle');
	const menu = document.getElementById('nav-menu');
	if (toggle && menu) {
		toggle.addEventListener('click', () => {
			menu.classList.toggle('is-open');
		});
	}
</script>
